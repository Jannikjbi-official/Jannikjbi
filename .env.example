# ---------------------------------------------------------------------------
# Jannikjbi.de – Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any real secret.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# MongoDB connection string. Content collections (games, genres, streams, ...)
# and the Better Auth collections (user, session, account, ...) live here.
MONGODB_URI=mongodb://127.0.0.1:27017/jannikjbi

# Optional: explicit database name (otherwise the one from MONGODB_URI is used).
# MONGODB_DB=jannikjbi

# Set to "false" for a standalone MongoDB without replica set, because the
# Better Auth Mongo adapter uses transactions by default when a client is given.
# MONGODB_TRANSACTIONS=true

# --- Better Auth -----------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the deployment, without trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# --- Better Auth Infrastructure (dash / analytics / event logging) ---------
# Optional. Without it the site still works; infra features are simply inactive.
BETTER_AUTH_API_KEY=
# BETTER_AUTH_API_URL=
# BETTER_AUTH_KV_URL=

# --- Discord OAuth ---------------------------------------------------------
# Redirect URL: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Twitch OAuth ----------------------------------------------------------
# Redirect URL: <BETTER_AUTH_URL>/api/auth/callback/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Authorization ---------------------------------------------------------
# Primary rule: comma separated Better Auth user ids that may enter /admin.
# The user id survives linking and unlinking providers, so this is the stable
# way to keep access. Find it under /admin/account once you are signed in.
ADMIN_USER_IDS=

# Bootstrap: a Discord account id that may enter /admin. Useful for the very
# first login, before a user id exists to put in ADMIN_USER_IDS. Leave empty
# to disable this path entirely.
ADMIN_DISCORD_ID=
# Optional comma separated Twitch user IDs (numeric) that are additionally
# allowed. Leave empty: a Twitch login then only grants access when that Twitch
# account is linked to the authorized Discord user.
ADMIN_TWITCH_IDS=

# --- Twitch Helix API (live status on the public site) ---------------------
# Optional. Reuses the Twitch OAuth app above via client credentials.
# Without it the site falls back to the manual stream schedule.
TWITCH_LOGIN=jannikjbi

# --- Creator Buddy (Notion) ------------------------------------------------
# Internal integration secret from https://www.notion.so/my-integrations
# Share the "Creator Buddy Dashboard" page with that integration afterwards.
# Without it the site works normally; the Notion panel just stays inactive.
NOTION_TOKEN=

# Optional fallbacks for the three Creator Buddy database ids. The same values
# can be pasted in the CMS under /admin/notion, which takes precedence.
# NOTION_CHANNELS_DB_ID=31d5fc21467e833fac80811a2847b59f
# NOTION_CONTENT_DB_ID=4215fc21467e83a2b90601e417f0b13e
# NOTION_SPONSORS_DB_ID=0605fc21467e834bbd9b818e43e7e1bf
# NOTION_TASKS_DB_ID=1f05fc21467e82db8be8818ec31e7ab6

# Shared secret for the scheduled sync at /api/cron/notion-sync.
# Unset means the route answers 404 like every other private endpoint.
CRON_SECRET=

# Shared secret for the one-off content seed at POST /api/admin/seed.
# Set it, run the seed once, then remove it again — without it the route 404s.
SEED_SECRET=

# --- Public site -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://jannikjbi.de
